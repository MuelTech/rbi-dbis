# =============================================================================
# RBI-DBIS Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
#
# DO NOT commit your actual .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# MySQL connection string
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://root:@localhost:3306/rbi_dbis


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# The port the API server listens on
PORT=4000

# The host/interface the server binds to (use 0.0.0.0 to accept all interfaces)
HOST=0.0.0.0

# Node environment: development | production | test
NODE_ENV=development


# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Secret key used to sign JWT tokens.
# CHANGE THIS to a strong, random string in production!
#   Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret

# How long tokens remain valid (e.g. 8h, 7d, 30m)
JWT_EXPIRES_IN=8h
